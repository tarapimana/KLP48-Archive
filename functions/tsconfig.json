{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "..",
    "noEmit": true,
    "strict": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../server/socialTrackingValidation.ts",
    "../src/data/klp48Data.ts",
    "../src/types/socialTracking.ts",
    "firebase-target.json"
  ],
  "exclude": ["node_modules", "lib", "test"]
}
