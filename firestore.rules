rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Hardened administrator authentication requiring verified email
    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email == 'it.aiman2009@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    // 2. Member validation restricting strictly to the 20 exact canonical active KLP48 member IDs
    // Strictly excludes graduated members (cocoa, yurina, lucine, haruka, suzuha) and non-active member (cindy)
    function isActiveMemberId(memberId) {
      return memberId in [
        'yi_shyan', 'devi', 'amanda', 'ann_drea', 'hillary',
        'khalies', 'salwa', 'tiffany', 'maia', 'mashiro',
        'sharleez', 'shu_zhen', 'tara', 'aisha', 'alice',
        'diva', 'hana', 'isabel', 'joo', 'kei'
      ];
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId']) &&
             data.keys().hasOnly(['userId', 'displayName', 'pinnedMembers', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             (!data.keys().has('displayName') || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!data.keys().has('pinnedMembers') || data.pinnedMembers is list) &&
             (!data.keys().has('updatedAt') || data.updatedAt is string);
    }

    // 3. Documented field validation with keys().hasOnly(...) and canonical active member ID check
    function isValidLiveStatus(data) {
      return data.keys().hasAll(['memberId', 'memberName', 'platform', 'status', 'checkedAt']) &&
             data.keys().hasOnly(['memberId', 'memberName', 'platform', 'status', 'checkedAt', 'source', 'startedAt', 'liveUrl']) &&
             data.memberId is string && data.memberId.size() <= 64 && isActiveMemberId(data.memberId) &&
             data.memberName is string && data.memberName.size() <= 100 &&
             data.platform in ['tiktok', 'instagram'] &&
             data.status in ['LIVE', 'OFFLINE', 'UNKNOWN'] &&
             data.checkedAt is string &&
             (!data.keys().has('source') || (data.source is string && data.source.size() <= 100)) &&
             (!data.keys().has('startedAt') || data.startedAt is string || data.startedAt == null) &&
             (!data.keys().has('liveUrl') || (data.liveUrl is string && data.liveUrl.size() <= 500));
    }

    function isValidLiveSession(data) {
      return data.keys().hasAll(['memberId', 'memberName', 'platform', 'startedAt', 'endedAt']) &&
             data.keys().hasOnly(['memberId', 'memberName', 'platform', 'startedAt', 'endedAt', 'duration', 'liveUrl', 'source']) &&
             data.memberId is string && data.memberId.size() <= 64 && isActiveMemberId(data.memberId) &&
             data.memberName is string && data.memberName.size() <= 100 &&
             data.platform in ['tiktok', 'instagram'] &&
             data.startedAt is string &&
             data.endedAt is string &&
             (!data.keys().has('duration') || data.duration is number || data.duration is string) &&
             (!data.keys().has('liveUrl') || (data.liveUrl is string && data.liveUrl.size() <= 500)) &&
             (!data.keys().has('source') || (data.source is string && data.source.size() <= 100));
    }

    function isValidScheduleEvent(data) {
      return data.keys().hasAll([
               'tarikh_mula', 'tarikh_tamat', 'tajuk', 'tajuk_en', 'lokasi',
               'lokasi_en', 'masa', 'masa_en', 'jenis', 'eksklusif', 'nota',
               'nota_en', 'members', 'pautan'
             ]) &&
             data.keys().hasOnly([
               'tarikh_mula', 'tarikh_tamat', 'tajuk', 'tajuk_en', 'lokasi',
               'lokasi_en', 'masa', 'masa_en', 'jenis', 'eksklusif', 'nota',
               'nota_en', 'members', 'pautan'
             ]) &&
             data.tarikh_mula is string && data.tarikh_mula.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.tarikh_tamat is string && data.tarikh_tamat.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.tajuk is string && data.tajuk.size() <= 300 &&
             data.tajuk_en is string && data.tajuk_en.size() <= 300 &&
             data.lokasi is string && data.lokasi.size() <= 500 &&
             data.lokasi_en is string && data.lokasi_en.size() <= 500 &&
             data.masa is string && data.masa.size() <= 200 &&
             data.masa_en is string && data.masa_en.size() <= 200 &&
             data.jenis in ['show', 'event'] &&
             data.eksklusif in ['yes', 'no'] &&
             data.nota is string && data.nota.size() <= 2000 &&
             data.nota_en is string && data.nota_en.size() <= 2000 &&
             data.members is string && data.members.size() <= 1000 &&
             data.pautan is string && data.pautan.size() <= 1000 &&
             (data.pautan == '' || data.pautan.matches('^https?://.*'));
    }

    function isValidTrackedMemberIds(memberIds) {
      return memberIds is list && memberIds.size() <= 20 &&
             memberIds.hasOnly([
               'yi_shyan', 'devi', 'amanda', 'ann_drea', 'hillary',
               'khalies', 'salwa', 'tiffany', 'maia', 'mashiro',
               'sharleez', 'shu_zhen', 'tara', 'aisha', 'alice',
               'diva', 'hana', 'isabel', 'joo', 'kei'
             ]);
    }

    function isValidSocialTrackingConfig(data) {
      return data.keys().hasAll(['enabled', 'trackedMemberIds', 'timezone', 'updatedAt', 'updatedBy']) &&
             data.keys().hasOnly(['enabled', 'trackedMemberIds', 'timezone', 'updatedAt', 'updatedBy']) &&
             data.enabled is bool &&
             isValidTrackedMemberIds(data.trackedMemberIds) &&
             data.timezone is string && data.timezone.size() <= 64 &&
             data.updatedAt is timestamp &&
             data.updatedBy is string && data.updatedBy.size() <= 128;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId);
    }

    // Public read-only for verified LIVE status and session history
    // Anonymous visitors and untrusted clients CANNOT write or modify
    match /live_status/{statusId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(statusId) && isValidLiveStatus(request.resource.data);
      allow delete: if isAdmin() && isValidId(statusId);
    }

    match /live_sessions/{sessionId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(sessionId) && isValidLiveSession(request.resource.data);
      allow delete: if isAdmin() && isValidId(sessionId);
    }

    // The public schedule is readable by visitors and writable only by the verified archive admin.
    match /schedule_events/{eventId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(eventId) && isValidScheduleEvent(request.resource.data);
      allow delete: if isAdmin() && isValidId(eventId);
    }

    // Credential records are server-only. The Admin SDK bypasses these rules and must be
    // protected by backend IAM; no browser client, including the admin UI, can access this path.
    match /social_accounts/{accountId} {
      allow read, write: if false;
    }

    // Firestore Rules cannot redact fields from a document. These dedicated public projection
    // collections must contain only SocialObservation fields; clients cannot write to them.
    match /social_snapshots/{snapshotId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /social_current/{currentId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // Tracking controls are available only to the verified archive administrator.
    match /social_tracking_config/{configId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(configId) &&
                            isValidSocialTrackingConfig(request.resource.data) &&
                            request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Logs are admin-readable and client writes are denied. Server writers must omit secrets
    // and log only sanitized codes rather than provider response bodies.
    match /social_tracking_logs/{logId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
